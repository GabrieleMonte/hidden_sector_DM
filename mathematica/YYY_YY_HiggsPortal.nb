Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
    "==="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"phi", 
     RowBox[{"(", "k1", ")"}], " ", "phi", 
     RowBox[{"(", "k2", ")"}], " ", "phi", 
     RowBox[{"(", "k3", ")"}]}], "->", 
    RowBox[{"phi", 
     RowBox[{"(", "p1", ")"}], " ", "phi", 
     RowBox[{"(", "p2", ")"}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"One", "-", 
    RowBox[{"loop", " ", 
     RowBox[{"pentagon", ":", 
      RowBox[{
      "Majorana", " ", "chi", " ", "in", " ", "the", " ", "loop"}]}]}]}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Vertex", ":", 
    RowBox[{"phi", " ", "chibar", " ", 
     RowBox[{"(", 
      RowBox[{"ls", "+", 
       RowBox[{"lp", " ", "i", " ", "gamma5"}]}], ")"}], " ", "chi"}]}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Let", " ", "FeynCalc", " ", "handle", " ", "trace"}], "+", 
    RowBox[{"tensor", " ", "reduction"}], "+", 
    RowBox[{"PV", " ", "decomposition"}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
    "==="}], "*)"}], 
  RowBox[{
   RowBox[{"<<", "FeynCalc`"}], "\n", 
   RowBox[{
    RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"1.", " ", "ON"}], "-", 
     RowBox[{"SHELL", " ", "CONDITIONS"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SPD", "[", 
      RowBox[{"k1", ",", "k1"}], "]"}], "=", 
     RowBox[{"mphi", "^", "2"}]}], ";", 
    RowBox[{
     RowBox[{"SPD", "[", 
      RowBox[{"k2", ",", "k2"}], "]"}], "=", 
     RowBox[{"mphi", "^", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SPD", "[", 
      RowBox[{"k3", ",", "k3"}], "]"}], "=", 
     RowBox[{"mphi", "^", "2"}]}], ";", 
    RowBox[{
     RowBox[{"SPD", "[", 
      RowBox[{"p1", ",", "p1"}], "]"}], "=", 
     RowBox[{"mphi", "^", "2"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "PENTAGON", " ", "AMPLITUDE", " ", "BUILDER"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "buildPentAmp", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"buildPentAmp", "[", 
      RowBox[{"ordering_List", ",", "vtx_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"e", "=", "ordering"}], ",", "Q", ",", "prop", ",", "num", 
         ",", "amp"}], "}"}], ",", 
       RowBox[{
        RowBox[{"Q", "=", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"e", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"e", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", 
            RowBox[{"e", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"e", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", 
            RowBox[{"e", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "+", 
            RowBox[{"e", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"e", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", 
            RowBox[{"e", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "+", 
            RowBox[{"e", "[", 
             RowBox[{"[", "3", "]"}], "]"}], "+", 
            RowBox[{"e", "[", 
             RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"prop", "[", "i_", "]"}], ":=", 
         RowBox[{
          RowBox[{"GSD", "[", "ell", "]"}], "+", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Q", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "===", "0"}], ",", "0", ",", 
            RowBox[{"GSD", "[", 
             RowBox[{"Q", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], "+", "mchi"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"num", "=", 
         RowBox[{"TR", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"prop", "[", "1", "]"}], ".", "vtx", ".", 
            RowBox[{"prop", "[", "2", "]"}], ".", "vtx", ".", 
            RowBox[{"prop", "[", "3", "]"}], ".", "vtx", ".", 
            RowBox[{"prop", "[", "4", "]"}], ".", "vtx", ".", 
            RowBox[{"prop", "[", "5", "]"}], ".", "vtx"}], ",", 
           RowBox[{"DiracTraceEvaluate", "->", "True"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"amp", "=", 
         RowBox[{
          RowBox[{"-", "num"}], "*", 
          RowBox[{"FAD", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"ell", ",", "mchi"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ell", "+", 
               RowBox[{"Q", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "mchi"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ell", "+", 
               RowBox[{"Q", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], ",", "mchi"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ell", "+", 
               RowBox[{"Q", "[", 
                RowBox[{"[", "4", "]"}], "]"}]}], ",", "mchi"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ell", "+", 
               RowBox[{"Q", "[", 
                RowBox[{"[", "5", "]"}], "]"}]}], ",", "mchi"}], "}"}]}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "amp", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "VERTICES"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Vfwd", "=", 
     RowBox[{"ls", "+", 
      RowBox[{"lp", " ", "I", " ", 
       RowBox[{"GA", "[", "5", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Vrev", "=", 
     RowBox[{"ls", "-", 
      RowBox[{"lp", " ", "I", " ", 
       RowBox[{"GA", "[", "5", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "BUILD", " ", "AMPLITUDES"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ordA", "=", 
     RowBox[{"{", 
      RowBox[{"k1", ",", "k2", ",", "k3", ",", 
       RowBox[{"-", "p1"}], ",", 
       RowBox[{"-", "p2"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ordB", "=", 
     RowBox[{"{", 
      RowBox[{"k1", ",", "k2", ",", 
       RowBox[{"-", "p1"}], ",", "k3", ",", 
       RowBox[{"-", "p2"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<=== Building amplitudes ===\>\"", "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"ampAfwd", "=", 
     RowBox[{"buildPentAmp", "[", 
      RowBox[{"ordA", ",", "Vfwd"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ampArev", "=", 
     RowBox[{"buildPentAmp", "[", 
      RowBox[{"ordA", ",", "Vrev"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ampBfwd", "=", 
     RowBox[{"buildPentAmp", "[", 
      RowBox[{"ordB", ",", "Vfwd"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ampBrev", "=", 
     RowBox[{"buildPentAmp", "[", 
      RowBox[{"ordB", ",", "Vrev"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<All 4 amplitudes built.\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"5.", " ", "MAJORANA"}], "+", 
     RowBox[{"EQUAL", " ", "COUPLINGS"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ampA", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ampAfwd", "+", "ampArev"}], ")"}], "/", "2"}], "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ls", "->", "lam"}], ",", 
         RowBox[{"lp", "->", "lam"}]}], "}"}]}], "//", "Expand"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"ampB", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ampBfwd", "+", "ampBrev"}], ")"}], "/", "2"}], "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ls", "->", "lam"}], ",", 
         RowBox[{"lp", "->", "lam"}]}], "}"}]}], "//", "Expand"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<ampA terms: \>\"", ",", 
      RowBox[{"Length", "[", "ampA", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<ampB terms: \>\"", ",", 
      RowBox[{"Length", "[", "ampB", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"6.", " ", 
     RowBox[{"TID", ":", 
      RowBox[{"TENSOR", " ", "INTEGRAL", " ", "DECOMPOSITION"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<=== TID: Pattern A ===\>\"", "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"tA", "=", 
     RowBox[{
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{
        RowBox[{"resA", "=", 
         RowBox[{"TID", "[", 
          RowBox[{"ampA", ",", "ell", ",", 
           RowBox[{"ToPaVe", "->", "True"}], ",", 
           RowBox[{"UsePaVeBasis", "->", "True"}]}], "]"}]}], ";"}], "]"}], 
      "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  Done in \>\"", ",", "tA", ",", "\"\< seconds.\>\""}], 
