 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]", "[", 
    RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
   RowBox[{
    SuperscriptBox["a", "2"], "+", 
    SuperscriptBox["b", "2"], "+", 
    SuperscriptBox["c", "2"], "-", 
    RowBox[{"2", "a", "*", "b"}], "-", 
    RowBox[{"2", "a", "*", "c"}], "-", 
    RowBox[{"2", "b", "*", "c"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pfoverpi", "[", 
    RowBox[{"m1_", ",", "m2_", ",", "m3_", ",", "m4_", ",", "s_"}], "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{"\[Lambda]", "[", 
       RowBox[{"s", ",", 
        SuperscriptBox["m3", "2"], ",", 
        SuperscriptBox["m4", "2"]}], "]"}], 
      RowBox[{"\[Lambda]", "[", 
       RowBox[{"s", ",", 
        SuperscriptBox["m1", "2"], ",", 
        SuperscriptBox["m2", "2"]}], "]"}]], ")"}], 
    RowBox[{"1", "/", "2"}]]}], ";"}], "\[IndentingNewLine]", 
