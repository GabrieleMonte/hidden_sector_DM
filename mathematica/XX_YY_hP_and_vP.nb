Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"dsigma", "/", "dOmega"}], " ", "with", " ", "S_f"}], "=", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", "for", " ", "identical", " ", "phi"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"d\[Sigma]d\[CapitalOmega]", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], "*", 
       RowBox[{
        RowBox[{"pfoverpi", "[", 
         RowBox[{"mX", ",", "mX", ",", "mY", ",", "mY", ",", "s"}], "]"}], 
        "/", 
        RowBox[{"(", 
         RowBox[{"64", " ", 
          RowBox[{"Pi", "^", "2"}], " ", "s"}], ")"}]}], "*", "MsqAvg"}], "/.",
       "\[IndentingNewLine]", 
      RowBox[{"t", "->", 
       RowBox[{"tOfCosTheta", "[", 
        RowBox[{
        "mX", ",", "mX", ",", "mY", ",", "mY", ",", "s", ",", "cos\[Theta]"}],
         "]"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\nIntegrating over cos(theta)...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Sigma]Int", "=", 
     RowBox[{
      RowBox[{"2", " ", "Pi", "*", 
       RowBox[{"Integrate", "[", 
        RowBox[{"d\[Sigma]d\[CapitalOmega]", ",", "cos\[Theta]", ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Im", "[", "mX", "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{"Im", "[", "mY", "]"}], "==", "0"}], ",", 
            RowBox[{"mX", ">", "mY", ">", "0"}], ",", 
            RowBox[{"s", ">", 
             RowBox[{"4", " ", 
              RowBox[{"mX", "^", "2"}]}]}]}], "}"}]}]}], "]"}]}], "//", 
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{"\[Sigma]Int", "/.", " ", 
      RowBox[{"{", 
       RowBox[{"cos\[Theta]", "->", "1"}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"B", "=", 
     RowBox[{"\[Sigma]Int", "/.", " ", 
      RowBox[{"{", 
       RowBox[{"cos\[Theta]", "->", 
        RowBox[{"-", "1"}]}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Sigma]", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"A", "-", "B"}], ")"}], "//", "FullSimplify"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Sigma]vMol", "=", 
     RowBox[{
      RowBox[{"\[Sigma]", "*", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"\[Lambda]", "[", 
          RowBox[{"s", ",", 
           RowBox[{"mX", "^", "2"}], ",", 
           RowBox[{"mX", "^", "2"}]}], "]"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"s", "/", "2"}], ")"}]}]}], "//", "FullSimplify"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.981878162406426*^9, 3.981878174568675*^9}},
