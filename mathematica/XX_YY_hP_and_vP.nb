   RowBox[{
    RowBox[{"SetMandelstam", "[", 
     RowBox[{"s", ",", "t", ",", "u", ",", "p1", ",", "p2", ",", 
      RowBox[{"-", "k1"}], ",", 
      RowBox[{"-", "k2"}], ",", "mX", ",", "mX", ",", "mY", ",", "mY"}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Propagator", " ", "and", " ", "vertex"}], "*)"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"V", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "I"}], " ", "lams"}], "-", 
      RowBox[{"I", " ", "lamp", " ", 
       RowBox[{"GA", "[", "5", "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Four", " ", "individual", " ", "amplitudes"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Direct", " ", 
     RowBox[{"diagrams", ":", 
      RowBox[{
       RowBox[{
        RowBox[{"v", "-", 
         RowBox[{"bar", 
          RowBox[{"(", "p2", ")"}]}]}], "..."}], " ", "u", 
       RowBox[{"(", "p1", ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"A1", ":", 
      RowBox[{"t", "-", "channel"}]}], ",", 
     RowBox[{
      RowBox[{"propagator", " ", "p1"}], "-", "k1"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"A2", ":", 
      RowBox[{"u", "-", "channel"}]}], ",", 
     RowBox[{
      RowBox[{"propagator", " ", "p1"}], "-", "k2"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Exchange", " ", "diagrams", " ", 
      RowBox[{"(", 
       RowBox[{"p1", "<->", "p2"}], ")"}]}], ":", 
     RowBox[{
      RowBox[{
       RowBox[{"v", "-", 
        RowBox[{"bar", 
         RowBox[{"(", "p1", ")"}]}]}], "..."}], " ", "u", 
      RowBox[{"(", "p2", ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"A3", ":", 
      RowBox[{"t", "-", "channel"}]}], ",", 
     RowBox[{
      RowBox[{"propagator", " ", "p2"}], "-", "k1"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"A4", ":", 
      RowBox[{"u", "-", "channel"}]}], ",", 
     RowBox[{
      RowBox[{"propagator", " ", "p2"}], "-", "k2"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Full", " ", 
      RowBox[{"amplitude", ":", "iM"}]}], "=", 
     RowBox[{"A1", "+", "A2", "-", "A3", "-", "A4"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"(", 
     RowBox[{
     "minus", " ", "sign", " ", "on", " ", "exchange", " ", "from", " ", 
      "Fermi", " ", "statistics"}], ")"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A1", "=", 
     RowBox[{"FCI", "[", 
      RowBox[{
       RowBox[{"SpinorVBar", "[", 
        RowBox[{"p2", ",", "mX"}], "]"}], ".", "V", ".", 
       RowBox[{"\[CapitalDelta]fermion", "[", 
        RowBox[{
         RowBox[{"p1", "-", "k1"}], ",", "mX"}], "]"}], ".", "V", ".", 
       RowBox[{"SpinorU", "[", 
        RowBox[{"p1", ",", "mX"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"A2", "=", 
     RowBox[{"FCI", "[", 
      RowBox[{
       RowBox[{"SpinorVBar", "[", 
        RowBox[{"p2", ",", "mX"}], "]"}], ".", "V", ".", 
       RowBox[{"\[CapitalDelta]fermion", "[", 
        RowBox[{
         RowBox[{"p1", "-", "k2"}], ",", "mX"}], "]"}], ".", "V", ".", 
       RowBox[{"SpinorU", "[", 
        RowBox[{"p1", ",", "mX"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"A3", "=", 
     RowBox[{"FCI", "[", 
      RowBox[{
       RowBox[{"SpinorVBar", "[", 
        RowBox[{"p1", ",", "mX"}], "]"}], ".", "V", ".", 
       RowBox[{"\[CapitalDelta]fermion", "[", 
        RowBox[{
         RowBox[{"p2", "-", "k1"}], ",", "mX"}], "]"}], ".", "V", ".", 
       RowBox[{"SpinorU", "[", 
        RowBox[{"p2", ",", "mX"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"A4", "=", 
     RowBox[{"FCI", "[", 
      RowBox[{
       RowBox[{"SpinorVBar", "[", 
        RowBox[{"p1", ",", "mX"}], "]"}], ".", "V", ".", 
       RowBox[{"\[CapitalDelta]fermion", "[", 
        RowBox[{
         RowBox[{"p2", "-", "k2"}], ",", "mX"}], "]"}], ".", "V", ".", 
       RowBox[{"SpinorU", "[", 
        RowBox[{"p2", ",", "mX"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"amps", "=", 
     RowBox[{"{", 
      RowBox[{"A1", ",", "A2", ",", "A3", ",", "A4"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"signs", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"+", "1"}], ",", 
       RowBox[{"+", "1"}], ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Process", " ", "one", " ", "interference", " ", "term"}], 
    "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"proc", "[", 
      RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "nI", ",", "nJ", ",", "sI", ",", "sJ", ",", "cc", ",", "Mij"}], "}"}],
        ",", 
       RowBox[{
        RowBox[{"nI", "=", 
         RowBox[{"amps", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"nJ", "=", 
         RowBox[{"amps", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sI", "=", 
         RowBox[{"signs", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sJ", "=", 
         RowBox[{"signs", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"cc", "=", 
         RowBox[{"ComplexConjugate", "[", "nJ", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Mij", "=", 
         RowBox[{
          RowBox[{"FermionSpinSum", "[", 
           RowBox[{"DiracSimplify", "[", 
            RowBox[{"FCI", "[", 
             RowBox[{"nI", " ", "cc"}], "]"}], "]"}], "]"}], "/.", " ", 
          RowBox[{"DiracTrace", "->", "TR"}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"Mij", "=", 
         RowBox[{
          RowBox[{"Contract", "[", "Mij", "]"}], "//", 
          "ExpandScalarProduct"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Mij", "=", 
         RowBox[{"Mij", "/.", " ", 
          RowBox[{"u", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", 
              RowBox[{"mX", "^", "2"}]}], "+", 
             RowBox[{"2", " ", 
              RowBox[{"mY", "^", "2"}]}], "-", "s", "-", "t"}], ")"}]}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Multiply", " ", "by", " ", "sign", " ", "factors"}], "*)"}], 
        RowBox[{"Mij", "=", 
         RowBox[{"sI", " ", "sJ", " ", "Mij"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"Mij", "//", "FullSimplify"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\n", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "Compute", " ", "all", " ", "10", " ", "terms"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<===== Computing diagonal terms =====\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<  (\>\"", ",", "i", ",", "\"\<,\>\"", ",", "i", ",", 
         "\"\<) ...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"term", "[", 
         RowBox[{"i", ",", "i"}], "]"}], "=", 
        RowBox[{"proc", "[", 
         RowBox[{"i", ",", "i"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<    Done.\>\"", "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n===== Computing off-diagonal terms =====\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<  (\>\"", ",", "i", ",", "\"\<,\>\"", ",", "j", ",", 
         "\"\<) ...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"term", "[", 
         RowBox[{"i", ",", "j"}], "]"}], "=", 
        RowBox[{"2", " ", 
         RowBox[{"proc", "[", 
          RowBox[{"i", ",", "j"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<    Done.\>\"", "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"i", "+", "1"}], ",", "4"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "6.", " ", "Sum", " ", "all", " ", "terms", " ", "and", " ", "spin"}], 
     "-", "average"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MsqTotal", "=", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"term", "[", 
         RowBox[{"i", ",", "i"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}], "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"term", "[", 
         RowBox[{"i", ",", "j"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"i", "+", "1"}], ",", "4"}], "}"}]}], "]"}]}]}], ";"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Spin", " ", 
      RowBox[{"average", ":", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", "2"}], ")"}]}]}]}], "=", 
     RowBox[{"1", "/", "4"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MsqAvg", "=", 
     RowBox[{
      RowBox[{"MsqTotal", "/", "4"}], "//", "FullSimplify"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<\\n===== Spin-averaged |M|^2 (piece-by-piece) =====\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "MsqAvg", "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.981746154185161*^9, 3.9817461764361067`*^9}, {
