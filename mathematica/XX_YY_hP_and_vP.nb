Cell[BoxData[{"ClearScalarProducts", "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalDelta]fermion", "[", 
    RowBox[{"p_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{"I", "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"GS", "[", "p", "]"}], "+", "m"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"ScalarProduct", "[", 
         RowBox[{"p", ",", "p"}], "]"}], "-", 
        RowBox[{"m", "^", "2"}]}], ")"}]}]}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"E1cm", "[", 
    RowBox[{"m1_", ",", "m2_", ",", "s_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{"s", "+", 
      SuperscriptBox["m1", "2"], "-", 
      SuperscriptBox["m2", "2"]}], ")"}], 
    RowBox[{"2", 
     RowBox[{"\[Sqrt]", "s"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"E3cm", "[", 
    RowBox[{"m3_", ",", "m4_", ",", "s_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{"s", "+", 
      SuperscriptBox["m3", "2"], "-", 
      SuperscriptBox["m4", "2"]}], ")"}], 
    RowBox[{"2", 
     RowBox[{"\[Sqrt]", "s"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p1cm", "[", 
    RowBox[{"m1_", ",", "m2_", ",", "s_"}], "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"E1cm", "[", 
       RowBox[{"m1", ",", "m2", ",", "s"}], "]"}], "2"], "-", 
     SuperscriptBox["m1", "2"]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p3cm", "[", 
    RowBox[{"m3_", ",", "m4_", ",", "s_"}], "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
