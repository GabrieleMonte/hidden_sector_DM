Cell[CellGroupData[{

Cell["Load and sum", "Section",ExpressionUUID->"082c430e-b511-4a99-b3f3-38e9cefb36ca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"outputDir", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      "\"\<MsqTerms_YXX_XX_vP_v2\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"files", "=", 
   RowBox[{"FileNames", "[", 
    RowBox[{"\"\<*.m\>\"", ",", "outputDir"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Loading \>\"", ",", 
    RowBox[{"Length", "[", "files", "]"}], ",", "\"\< terms...\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"MsqTotal", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"term", "=", 
      RowBox[{"Get", "[", "f", "]"}]}], ";", 
     RowBox[{"MsqTotal", "+=", "term"}], ";", 
     RowBox[{"Clear", "[", "term", "]"}], ";"}], ",", 
    RowBox[{"{", 
     RowBox[{"f", ",", "files"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"MsqAvgNR", "=", 
   RowBox[{
    RowBox[{"MsqTotal", "/", "12"}], "//", "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.984564364098599*^9, 3.984564364841617*^9}},
