     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "r"}]}], ")"}], "4"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "r", "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["r", "2"]}]}], ")"}], "2"]}], ")"}]}]], "Output",
 CellChangeTimes->{3.984564625709133*^9},
