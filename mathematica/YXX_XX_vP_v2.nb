Cell[BoxData[
 RowBox[{"MsqAvgNR", "//", "FullSimplify"}]], "Input",ExpressionUUID->"976a9c93-cdb8-405d-82e1-1d4ba39f68a6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sqrtsNR", "=", 
   RowBox[{"mY", "+", 
    RowBox[{"2", " ", "mX"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sNR", "=", 
   RowBox[{"sqrtsNR", "^", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Kallen", "[", 
    RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"a", "^", "2"}], "+", 
    RowBox[{"b", "^", "2"}], "+", 
    RowBox[{"c", "^", "2"}], "-", 
    RowBox[{"2", " ", "a", " ", "b"}], "-", 
    RowBox[{"2", " ", "a", " ", "c"}], "-", 
    RowBox[{"2", " ", "b", " ", "c"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lambdaNR", "=", 
    RowBox[{
     RowBox[{"Kallen", "[", 
      RowBox[{"sNR", ",", 
       RowBox[{"mX", "^", "2"}], ",", 
       RowBox[{"mX", "^", "2"}]}], "]"}], "/.", 
     RowBox[{"mY", "\[Rule]", 
      RowBox[{"mX", "/", "r"}]}], "//", "Simplify"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigmav2NR", "=", 
   RowBox[{"MsqAvgNR", "*", 
    RowBox[{"Sqrt", "[", "lambdaNR", "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"64", " ", "Pi", " ", "mY", " ", 
      RowBox[{"mX", "^", "2"}], " ", "sNR"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigmav2NR", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4", " ", "Pi", " ", "alphaX"}], ")"}], "^", "3"}], "*", 
     "sigmav2NR"}], "/.", 
    RowBox[{"mY", "\[Rule]", 
     RowBox[{"mX", "/", "r"}]}], "//", "Simplify"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Delta2", "=", 
  RowBox[{
   RowBox[{"PowerExpand", "[", 
    RowBox[{"sigmav2NR", "*", 
     RowBox[{
      RowBox[{"mX", "^", "5"}], "/", 
      RowBox[{"alphaX", "^", "3"}]}]}], "]"}], "//", 
   "FullSimplify"}]}]}], "Input",
 CellLabel->"In[73]:=",ExpressionUUID->"4d3054d2-63ea-49cf-bba1-54d1624e704e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
