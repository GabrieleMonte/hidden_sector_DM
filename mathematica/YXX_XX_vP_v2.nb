    SuperscriptBox["alphaX", "3"], " ", 
    SuperscriptBox["\[Pi]", "2"], " ", 
    SuperscriptBox["r", "5"], " ", 
    SqrtBox[
     FractionBox[
      RowBox[{
       SuperscriptBox["mX", "4"], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "r"}]}], ")"}], "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
