Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", "Off"}]}], "-", 
    RowBox[{"diagonal", " ", 
     RowBox[{"terms", ":", " ", 
      RowBox[{
       RowBox[{
       "factor", " ", "of", " ", "2", " ", "and", " ", "relative", " ", 
        "Fermi", " ", 
        RowBox[{"sign", "--"}]}], "-"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<(\>\"", ",", " ", "i", ",", " ", "\"\<,\>\"", ",", " ", "j", ",",
          " ", "\"\<) ...\>\""}], "]"}], ";", "\n", "  ", 
       RowBox[{"term", " ", "=", " ", 
        RowBox[{"2", " ", 
         RowBox[{"signs", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{"signs", "[", 
          RowBox[{"[", "j", "]"}], "]"}], " ", 
         RowBox[{"proc", "[", 
          RowBox[{"i", ",", " ", "j"}], "]"}]}]}], ";", "\n", "  ", 
       RowBox[{"Put", "[", 
        RowBox[{"term", ",", "\n", "   ", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"outputDir", ",", "\n", "     ", 
            RowBox[{"\"\<offdiag_\>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", "i", "]"}], " ", "<>", " ", "\"\<_\>\"",
              " ", "<>", " ", 
             RowBox[{"ToString", "[", "j", "]"}], " ", "<>", " ", 
             "\"\<.m\>\""}]}], "}"}], "]"}]}], "]"}], ";", "\n", "  ", 
       RowBox[{"Clear", "[", "term", "]"}], ";", "\n", "  ", 
       RowBox[{"Print", "[", "\"\<  Done.\>\"", "]"}], ";"}], "\n", "  ", ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "1", ",", " ", "8"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", 
        RowBox[{"i", " ", "+", " ", "1"}], ",", " ", "8"}], "}"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nAll 36 terms saved to: \>\"", ",", " ", "outputDir"}], 
