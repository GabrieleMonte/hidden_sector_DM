     RowBox[{"t", "\[Rule]", 
      RowBox[{"tOfCosTheta", "[", 
       RowBox[{
       "mX", ",", "mX", ",", "mY", ",", "mY", ",", "s", ",", "cos\[Theta]"}], 
       "]"}]}]}], "//", "FullSimplify"}]}], ";"}]], "Input",ExpressionUUID->\
