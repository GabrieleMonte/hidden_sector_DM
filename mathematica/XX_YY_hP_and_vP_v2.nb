Cell[BoxData[
 RowBox[{
  RowBox[{"d\[Sigma]d\[CapitalOmega]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], "*", 
      RowBox[{
       RowBox[{"pfoverpi", "[", 
        RowBox[{"mX", ",", "mX", ",", "mY", ",", "mY", ",", "s"}], "]"}], "/", 
       RowBox[{"(", 
