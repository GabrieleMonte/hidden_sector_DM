Cell[BoxData[{
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Helper", " ", "functions"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"E1cm", "[", 
    RowBox[{"m1_", ",", "m2_", ",", "s_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"s", "+", 
      RowBox[{"m1", "^", "2"}], "-", 
      RowBox[{"m2", "^", "2"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      RowBox[{"Sqrt", "[", "s", "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"E3cm", "[", 
    RowBox[{"m3_", ",", "m4_", ",", "s_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"s", "+", 
      RowBox[{"m3", "^", "2"}], "-", 
      RowBox[{"m4", "^", "2"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", 
      RowBox[{"Sqrt", "[", "s", "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p1cm", "[", 
    RowBox[{"m1_", ",", "m2_", ",", "s_"}], "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"E1cm", "[", 
       RowBox[{"m1", ",", "m2", ",", "s"}], "]"}], "^", "2"}], "-", 
     RowBox[{"m1", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p3cm", "[", 
    RowBox[{"m3_", ",", "m4_", ",", "s_"}], "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"E3cm", "[", 
       RowBox[{"m3", ",", "m4", ",", "s"}], "]"}], "^", "2"}], "-", 
     RowBox[{"m3", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]", "[", 
    RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"a", "^", "2"}], "+", 
    RowBox[{"b", "^", "2"}], "+", 
    RowBox[{"c", "^", "2"}], "-", 
    RowBox[{"2", " ", "a", " ", "b"}], "-", 
    RowBox[{"2", " ", "a", " ", "c"}], "-", 
    RowBox[{"2", " ", "b", " ", "c"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pfoverpi", "[", 
    RowBox[{"m1_", ",", "m2_", ",", "m3_", ",", "m4_", ",", "s_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Lambda]", "[", 
       RowBox[{"s", ",", 
        RowBox[{"m3", "^", "2"}], ",", 
        RowBox[{"m4", "^", "2"}]}], "]"}], "/", 
      RowBox[{"\[Lambda]", "[", 
       RowBox[{"s", ",", 
        RowBox[{"m1", "^", "2"}], ",", 
        RowBox[{"m2", "^", "2"}]}], "]"}]}], ")"}], "^", 
    RowBox[{"(", 
     RowBox[{"1", "/", "2"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tOfCosTheta", "[", 
    RowBox[{
    "m1_", ",", "m2_", ",", "m3_", ",", "m4_", ",", "s_", ",", 
     "cos\[Theta]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"m1", "^", "2"}], "+", 
    RowBox[{"m3", "^", "2"}], "-", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"E1cm", "[", 
         RowBox[{"m1", ",", "m2", ",", "s"}], "]"}], "*", 
        RowBox[{"E3cm", "[", 
         RowBox[{"m3", ",", "m4", ",", "s"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"p1cm", "[", 
         RowBox[{"m1", ",", "m2", ",", "s"}], "]"}], "*", 
        RowBox[{"p3cm", "[", 
         RowBox[{"m3", ",", "m4", ",", "s"}], "]"}], "*", "cos\[Theta]"}]}], 
      ")"}]}]}]}], ";"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"828cd0fd-0d4d-4ae2-8564-a6b64994a2df"],

