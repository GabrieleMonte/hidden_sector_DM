              RowBox[{"v", "^", "2"}], "/", "4"}]}], ")"}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"v", ",", "0", ",", "2"}], "}"}]}], "]"}], "]"}], "]"}], "//",
     "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aComputed", "=", 
