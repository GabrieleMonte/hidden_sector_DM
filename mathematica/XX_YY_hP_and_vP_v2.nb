          RowBox[{"GA", "[", "5", "]"}]}]}], ")"}], ".", 
       RowBox[{"SpinorU", "[", 
        RowBox[{"p1", ",", "mX"}], "]"}]}], "/", 
      RowBox[{"(", 
       RowBox[{"t", "-", 
        RowBox[{"mX", "^", "2"}]}], ")"}]}], "+", 
     RowBox[{
      RowBox[{
       RowBox[{"SpinorVBar", "[", 
        RowBox[{"p2", ",", "mX"}], "]"}], ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "I"}], " ", "lams"}], "-", 
