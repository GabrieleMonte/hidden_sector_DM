Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", "\"\<\\nIntegrating over cos(theta)...\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Sigma]Int", "=", 
   RowBox[{
    RowBox[{"2", " ", "Pi", "*", 
     RowBox[{"Integrate", "[", 
      RowBox[{"d\[Sigma]d\[CapitalOmega]", ",", "cos\[Theta]", ",", 
       RowBox[{"Assumptions", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Im", "[", "mX", "]"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{"Im", "[", "mY", "]"}], "==", "0"}], ",", 
          RowBox[{"mX", ">", "mY", ">", "0"}], ",", 
          RowBox[{"s", ">", 
           RowBox[{"4", " ", 
            RowBox[{"mX", "^", "2"}]}]}]}], "}"}]}]}], "]"}]}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"\[Sigma]Int", "/.", " ", 
    RowBox[{"{", 
     RowBox[{"cos\[Theta]", "\[Rule]", "1"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"\[Sigma]Int", "/.", " ", 
    RowBox[{"{", 
     RowBox[{"cos\[Theta]", "\[Rule]", 
      RowBox[{"-", "1"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", "-", "B"}], ")"}], "//", "FullSimplify"}]}], 
  ";"}]}], "Input",ExpressionUUID->"6df0c1c7-adb9-46c3-8ecb-45cb81a61c5c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Sigma]vMol", "=", 
   RowBox[{
    RowBox[{"\[Sigma]", "*", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"s", ",", 
         RowBox[{"mX", "^", "2"}], ",", 
         RowBox[{"mX", "^", "2"}]}], "]"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"s", "/", "2"}], ")"}]}]}], "//", "FullSimplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<\\nExpanding in v...\>\"", "]"}], 
