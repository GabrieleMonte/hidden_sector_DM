          RowBox[{"GA", "[", "5", "]"}]}]}], ")"}], ".", 
       RowBox[{"SpinorU", "[", 
        RowBox[{"p1", ",", "mX"}], "]"}]}], "/", 
      RowBox[{"(", 
       RowBox[{"u", "-", 
        RowBox[{"mX", "^", "2"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Exchange", " ", 
    RowBox[{"diagrams", ":", " ", 
     RowBox[{"p1", " ", "\[LeftRightArrow]", " ", "p2"}]}]}], " ", 
