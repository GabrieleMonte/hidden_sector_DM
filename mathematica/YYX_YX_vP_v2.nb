Cell[CellGroupData[{

Cell["Load and sum all terms", "Section",ExpressionUUID->"abb24f39-9482-434b-9096-89638d0c37c0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"outputDir", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      "\"\<MsqTerms_YYX_YX_vP_v2\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"files", "=", 
   RowBox[{"FileNames", "[", 
    RowBox[{"\"\<*.m\>\"", ",", "outputDir"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Loading \>\"", ",", 
    RowBox[{"Length", "[", "files", "]"}], ",", "\"\< terms...\>\""}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MsqTotal", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"term", "=", 
      RowBox[{"Get", "[", "f", "]"}]}], ";", 
     RowBox[{"MsqTotal", "+=", "term"}], ";", 
     RowBox[{"Clear", "[", "term", "]"}], ";"}], ",", 
    RowBox[{"{", 
     RowBox[{"f", ",", "files"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"MsqAvgNR", "=", 
   RowBox[{
    RowBox[{"MsqTotal", "/", "18"}], "//", "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9845555170623703`*^9, 3.984555517647654*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"d841eea9-aaf9-4a8c-a380-debc409ddcc0"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Loading \"\>", "\[InvisibleSpace]", "21", 
   "\[InvisibleSpace]", "\<\" terms...\"\>"}],
  SequenceForm["Loading ", 21, " terms..."],
  Editable->False]], "Print",
 CellChangeTimes->{3.98455552011666*^9, 3.9845573616532583`*^9},
 CellLabel->
  "During evaluation of \
In[47]:=",ExpressionUUID->"8871a792-f03e-4627-b408-06c047e61586"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"MsqAvgNR", "//", "FullSimplify"}]], "Input",ExpressionUUID->"98274f7c-3059-4bd3-8379-ef5dd7a2c87f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sqrtsNR", "=", 
   RowBox[{
    RowBox[{"2", " ", "mY"}], "+", "mX"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sNR", "=", 
   RowBox[{"sqrtsNR", "^", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Kallen", "[", 
