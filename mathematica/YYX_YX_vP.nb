        "\[IndentingNewLine]", 
        RowBox[{"(*", "Trace", "*)"}], 
        RowBox[{"Mij", "=", 
         RowBox[{
          RowBox[{"FermionSpinSum", "[", 
           RowBox[{"FCI", "[", 
            RowBox[{"nI", " ", "cc"}], "]"}], "]"}], "/.", " ", 
          RowBox[{"DiracTrace", "->", "TR"}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"(*", 
         RowBox[{"Sequential", " ", "polarization", " ", "sums"}], "*)"}], 
        RowBox[{"Mij", "=", 
         RowBox[{
          RowBox[{"polSum", "[", 
           RowBox[{"k1", ",", "mY", ",", "\[Mu]", ",", "\[Mu]p"}], "]"}], " ",
           "Mij"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Mij", "=", 
         RowBox[{
          RowBox[{"Contract", "[", "Mij", "]"}], "//", 
          "ExpandScalarProduct"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Mij", "=", 
         RowBox[{
          RowBox[{"polSum", "[", 
           RowBox[{"k2", ",", "mY", ",", "\[Nu]", ",", "\[Nu]p"}], "]"}], " ",
           "Mij"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Mij", "=", 
         RowBox[{
          RowBox[{"Contract", "[", "Mij", "]"}], "//", 
          "ExpandScalarProduct"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Mij", "=", 
         RowBox[{
          RowBox[{"polSum", "[", 
           RowBox[{"p1", ",", "mY", ",", "\[Rho]", ",", "\[Rho]p"}], "]"}], 
          " ", "Mij"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Mij", "=", 
         RowBox[{
          RowBox[{"Contract", "[", "Mij", "]"}], "//", 
          "ExpandScalarProduct"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Kill", " ", "any", " ", "D"}], "-", 
          RowBox[{"dimensional", " ", "objects"}]}], "*)"}], 
        RowBox[{"Mij", "=", 
         RowBox[{"ChangeDimension", "[", 
          RowBox[{"Mij", ",", "4"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Mij", "=", 
         RowBox[{"ExpandScalarProduct", "[", "Mij", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Diagnostic", ":", 
          RowBox[{
          "catch", " ", "any", " ", "surviving", " ", "Pair", " ", 
           "objects"}]}], "*)"}], 
        RowBox[{"leftover", "=", 
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{"Mij", ",", 
            RowBox[{"Pair", "[", "__", "]"}], ",", "Infinity"}], "]"}], "//", 
          "Union"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"leftover", "=!=", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<  WARNING: surviving Pair objects in (\>\"", ",", "i", ",", 
            "\"\<,\>\"", ",", "j", ",", "\"\<): \>\"", ",", "leftover"}], 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Divide", " ", "by", " ", "propagator", " ", "denominators", " ", 
          "and", " ", "apply", " ", "NR"}], "*)"}], 
        RowBox[{"Mij", "=", 
         RowBox[{"Mij", "/", 
          RowBox[{"(", 
           RowBox[{"dI", " ", "dJ"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Mij", "=", 
         RowBox[{"Mij", "/.", " ", "NRrules"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"Mij", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"PowerExpand", "[", "Mij", "]"}], "/.", 
           RowBox[{"mY", "->", 
            RowBox[{"mX", "/", "r"}]}]}], "//", 
          RowBox[{
           RowBox[{"FullSimplify", "[", 
            RowBox[{"#", ",", 
             RowBox[{
              RowBox[{"r", ">", "1"}], "&&", 
              RowBox[{"mX", ">", "0"}]}]}], "]"}], "&"}]}]}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.980802383475688*^9, 3.980802383480485*^9}, {
   3.980802435717885*^9, 3.980802438630391*^9}, {3.980807417437441*^9, 
