Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Diagonal"}]}], " ", 
     RowBox[{"terms", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<(\>\"", ",", "i", ",", "\"\<,\>\"", ",", "i", ",", 
         "\"\<) ...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"term", "=", 
        RowBox[{"proc", "[", 
         RowBox[{"i", ",", "i"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Put", "[", 
        RowBox[{"term", ",", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"outputDir", ",", 
            RowBox[{"\"\<diag_\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<_\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<.m\>\""}]}], 
           "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Clear", "[", "term", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<  Done.\>\"", "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "6"}], "}"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Off"}]}], "-", 
     RowBox[{"diagonal", " ", "terms", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"already", " ", "multiplied", " ", "by", " ", "2"}], ")"}], 
       "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<(\>\"", ",", "i", ",", "\"\<,\>\"", ",", "j", ",", 
         "\"\<) ...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"term", "=", 
        RowBox[{"2", " ", 
         RowBox[{"proc", "[", 
          RowBox[{"i", ",", "j"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Put", "[", 
        RowBox[{"term", ",", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"outputDir", ",", 
            RowBox[{"\"\<offdiag_\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<_\>\"", "<>", 
             RowBox[{"ToString", "[", "j", "]"}], "<>", "\"\<.m\>\""}]}], 
           "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Clear", "[", "term", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<  Done.\>\"", "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"i", "+", "1"}], ",", "6"}], "}"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nAll 21 terms saved to: \>\"", ",", "outputDir"}], "]"}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[105]:=",ExpressionUUID->"17cd7f7b-92b3-4db8-b70b-66aa73011a49"],

