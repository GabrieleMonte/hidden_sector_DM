Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", "Off"}]}], "-", 
    RowBox[{"diagonal", " ", "terms", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"already", " ", "multiplied", " ", "by", " ", "2"}], ")"}], 
      "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<(\>\"", ",", "i", ",", "\"\<,\>\"", ",", "j", ",", 
         "\"\<) ...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"term", "=", 
        RowBox[{"2", " ", 
         RowBox[{"procS", "[", 
          RowBox[{"i", ",", "j"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Put", "[", 
        RowBox[{"term", ",", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"outputDir", ",", 
            RowBox[{"\"\<offdiag_\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<_\>\"", "<>", 
             RowBox[{"ToString", "[", "j", "]"}], "<>", "\"\<.m\>\""}]}], 
           "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Clear", "[", "term", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<  Done.\>\"", "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"i", "+", "1"}], ",", "6"}], "}"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nAll 21 terms saved to: \>\"", ",", "outputDir"}], "]"}], 
    ";"}]}]}]], "Input",
