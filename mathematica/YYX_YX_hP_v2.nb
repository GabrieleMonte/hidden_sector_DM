Cell[CellGroupData[{

Cell["Load and sum", "Section",ExpressionUUID->"e850270b-246e-4a4d-a546-f313bb1e16f9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"outputDir", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      "\"\<MsqTerms_YYX_YX_hP_v2\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"files", "=", 
   RowBox[{"FileNames", "[", 
    RowBox[{"\"\<*.m\>\"", ",", "outputDir"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Loading \>\"", ",", 
    RowBox[{"Length", "[", "files", "]"}], ",", "\"\< terms...\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"MsqTotal", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"term", "=", 
      RowBox[{"Get", "[", "f", "]"}]}], ";", 
     RowBox[{"MsqTotal", "+=", "term"}], ";", 
     RowBox[{"Clear", "[", "term", "]"}], ";"}], ",", 
    RowBox[{"{", 
     RowBox[{"f", ",", "files"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"MsqAvgNR", "=", 
   RowBox[{
    RowBox[{"MsqTotal", "/", "2"}], "//", "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.984568986685523*^9, 3.984568987110923*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"298a2c85-c472-47c5-88e9-74e942d90027"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Loading \"\>", "\[InvisibleSpace]", "21", 
   "\[InvisibleSpace]", "\<\" terms...\"\>"}],
  SequenceForm["Loading ", 21, " terms..."],
  Editable->False]], "Print",
 CellChangeTimes->{3.984569019327795*^9, 3.984579378593855*^9},
