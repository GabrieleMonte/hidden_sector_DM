Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"proc[7,7] = \"\>", "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{"4", " ", 
     SuperscriptBox["r", "4"], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["lamp", "2"], "+", 
       RowBox[{
        SuperscriptBox["lams", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"4", " ", "r"}]}], ")"}]}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["lamp", "4"], " ", 
        RowBox[{"(", 
         RowBox[{"5", "+", 
          RowBox[{"6", " ", "r"}]}], ")"}]}], "+", 
       RowBox[{
        SuperscriptBox["lams", "4"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"2", " ", "r"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"5", "+", 
          RowBox[{"4", " ", 
           SuperscriptBox["r", "2"]}]}], ")"}]}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["lamp", "2"], " ", 
        SuperscriptBox["lams", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"5", "+", 
          RowBox[{"2", " ", "r", " ", 
           RowBox[{"(", 
            RowBox[{"4", "+", "r", "-", 
             RowBox[{"2", " ", 
              SuperscriptBox["r", "2"]}]}], ")"}]}]}], ")"}]}]}], ")"}]}], 
    RowBox[{
     SuperscriptBox["mX", "2"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", "r"}], ")"}], "2"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"2", " ", "r"}]}], ")"}], "2"]}]]}],
  SequenceForm[
  "proc[7,7] = ", 
   4 $CellContext`mX^(-2) $CellContext`r^4 (1 + $CellContext`r)^(-2) (1 + 
     2 $CellContext`r)^(-2) ($CellContext`lamp^2 + $CellContext`lams^2 (1 + 
      4 $CellContext`r)) ($CellContext`lamp^4 (5 + 
      6 $CellContext`r) + $CellContext`lams^4 (1 + 2 $CellContext`r) (5 + 
      4 $CellContext`r^2) + 
    2 $CellContext`lamp^2 $CellContext`lams^2 (5 + 
      2 $CellContext`r (4 + $CellContext`r - 2 $CellContext`r^2)))],
  Editable->False]], "Print",
 CellChangeTimes->{3.981756088750595*^9},
 CellLabel->
  "During evaluation of \
In[1]:=",ExpressionUUID->"132f9fc0-ce7b-4eb4-a899-cc7481f087e3"],

