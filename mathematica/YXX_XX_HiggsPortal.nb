Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Off"}]}], "-", 
     RowBox[{"diagonal", " ", 
      RowBox[{"terms", ":", 
       RowBox[{"factor", " ", "of", " ", "2"}]}]}]}], ",", 
    RowBox[{
     RowBox[{
     "with", " ", "relative", " ", "sign", " ", "from", " ", "signs", " ", 
      RowBox[{"array", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<(\>\"", ",", "i", ",", "\"\<,\>\"", ",", "j", ",", 
         "\"\<) ...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"term", "=", 
        RowBox[{"2", " ", 
         RowBox[{"signs", "[", 
          RowBox[{"[", "i", "]"}], "]"}], " ", 
         RowBox[{"signs", "[", 
          RowBox[{"[", "j", "]"}], "]"}], " ", 
         RowBox[{"proc", "[", 
          RowBox[{"i", ",", "j"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Put", "[", 
        RowBox[{"term", ",", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"outputDir", ",", 
            RowBox[{"\"\<offdiag_\>\"", "<>", 
             RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<_\>\"", "<>", 
             RowBox[{"ToString", "[", "j", "]"}], "<>", "\"\<.m\>\""}]}], 
           "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Clear", "[", "term", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<  Done.\>\"", "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "16"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"i", "+", "1"}], ",", "16"}], "}"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nAll 136 terms saved to: \>\"", ",", "outputDir"}], "]"}],
     ";"}]}]}]], "Input",
 CellChangeTimes->{3.98175622168611*^9},
 CellLabel->"In[95]:=",ExpressionUUID->"a0559f46-3084-49fb-84c2-cf76d49ce893"],

