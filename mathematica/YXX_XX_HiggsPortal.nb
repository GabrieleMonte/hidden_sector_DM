Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Load", " ", "and", " ", "sum", " ", "all", " ", "terms"}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"outputDir", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", 
        "\"\<MsqTerms_YXX_XX_HP\>\""}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"files", "=", 
     RowBox[{"FileNames", "[", 
      RowBox[{"\"\<*.m\>\"", ",", "outputDir"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Loading \>\"", ",", 
      RowBox[{"Length", "[", "files", "]"}], ",", "\"\< terms...\>\""}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"MsqTotal", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"term", "=", 
        RowBox[{"Get", "[", "f", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"MsqTotal", "+=", "term"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Clear", "[", "term", "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"f", ",", "files"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Spin", " ", 
      RowBox[{"average", ":", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"g_phi", "*", "g_chi", "*", "g_chi"}], ")"}]}]}]}], "=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", "*", "2", "*", "2"}], ")"}]}], "=", 
      RowBox[{"1", "/", "4"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"scalar", " ", 
       RowBox[{"phi", ":", 
        RowBox[{"1", " ", "state"}]}]}], ";", 
      RowBox[{"each", " ", "Majorana", " ", 
       RowBox[{"chi", ":", 
        RowBox[{"2", " ", "spin", " ", "states"}]}]}]}], ")"}], "*)"}], "\n", 
   
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MsqAvgNR", "=", 
     RowBox[{
      RowBox[{"MsqTotal", "/", "4"}], "//", "Simplify"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Display", " ", "result", " ", "in", " ", "terms", " ", "of", " ", 
      "mX"}], ",", "mY"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<\\n|M|^2_avg (NR) = \>\"", "]"}], ";"}], "\n", 
   
   RowBox[{"MsqAvgNR", "//", "FullSimplify"}]}]}]], "Input",
