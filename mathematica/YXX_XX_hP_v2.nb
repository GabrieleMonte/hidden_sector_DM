 RowBox[{
  RowBox[{
   RowBox[{"Kallen", "[", 
    RowBox[{"a_", ",", "b_", ",", "c_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"a", "^", "2"}], "+", 
    RowBox[{"b", "^", "2"}], "+", 
    RowBox[{"c", "^", "2"}], "-", 
    RowBox[{"2", " ", "a", " ", "b"}], "-", 
    RowBox[{"2", " ", "a", " ", "c"}], "-", 
    RowBox[{"2", " ", "b", " ", "c"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lambdaNR", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Kallen", "[", 
       RowBox[{"sNR", ",", 
        RowBox[{"mX", "^", "2"}], ",", 
        RowBox[{"mX", "^", "2"}]}], "]"}], "/.", 
      RowBox[{"mY", "\[Rule]", 
       RowBox[{"mX", "/", "r"}]}]}], "//", "Simplify"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"sigmav2NR", "=", 
   RowBox[{"MsqAvgNR", "*", 
    RowBox[{
     RowBox[{"Sqrt", "[", "lambdaNR", "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"64", " ", "Pi", " ", "mY", " ", 
       RowBox[{"mX", "^", "2"}], " ", "sNR"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sigmav2NR", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"PowerExpand", "[", "sigmav2NR", "]"}], "/.", 
      RowBox[{"mY", "\[Rule]", 
       RowBox[{"mX", "/", "r"}]}]}], "//", "FullSimplify"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Delta_", "2"}], ":", " ", "sigmav2"}], " ", "=", " ", 
    RowBox[{"Delta_", 
