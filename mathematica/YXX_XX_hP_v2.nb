Cell[CellGroupData[{

Cell["Load and sum", "Section",ExpressionUUID->"9bc7ee57-4e17-4a1c-97d1-f4696747cbeb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"outputDir", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      "\"\<MsqTerms_YXX_XX_hP_v2\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"files", "=", 
   RowBox[{"FileNames", "[", 
    RowBox[{"\"\<*.m\>\"", ",", "outputDir"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Loading \>\"", ",", 
    RowBox[{"Length", "[", "files", "]"}], ",", "\"\< terms...\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"MsqTotal", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"term", "=", 
      RowBox[{"Get", "[", "f", "]"}]}], ";", " ", 
     RowBox[{"MsqTotal", "+=", "term"}], ";", " ", 
     RowBox[{"Clear", "[", "term", "]"}], ";"}], ",", 
    RowBox[{"{", 
     RowBox[{"f", ",", "files"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"MsqAvgNR", "=", 
   RowBox[{
    RowBox[{"MsqTotal", "/", "4"}], "//", "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9845784515237207`*^9, 3.984578452039777*^9}},
 CellLabel->"In[62]:=",ExpressionUUID->"68cc5dbf-bb4d-49db-9ec9-20fc60514dad"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Loading \"\>", "\[InvisibleSpace]", "136", 
   "\[InvisibleSpace]", "\<\" terms...\"\>"}],
  SequenceForm["Loading ", 136, " terms..."],
  Editable->False]], "Print",
 CellChangeTimes->{3.984578963451954*^9},
 CellLabel->
  "During evaluation of \
In[62]:=",ExpressionUUID->"861142a4-8104-4c13-ade9-3c373b5e9b61"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MsqAvgNR", "//", "FullSimplify"}]], "Input",
 CellLabel->"In[68]:=",ExpressionUUID->"b7b3dd20-dd2c-4777-bbc6-9b781d160054"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{
    SuperscriptBox["mX", "2"], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "r", "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["r", "2"]}], "-", 
       RowBox[{"4", " ", 
        SuperscriptBox["r", "3"]}]}], ")"}], "2"]}]], 
  RowBox[{
   SuperscriptBox["r", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["lamp", "6"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", " ", "r"}]}], ")"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"4", " ", "r"}]}], ")"}], "3"]}], "+", 
     RowBox[{
