 RowBox[{
  RowBox[{
   RowBox[{"proc", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"cc", ",", "Mij"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"cc", "=", 
       RowBox[{
        RowBox[{"ComplexConjugate", "[", 
         RowBox[{
         "amps", "\[LeftDoubleBracket]", "j", "\[RightDoubleBracket]"}], 
         "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Conjugate", "[", "lams", "]"}], "\[Rule]", "lams"}], ",", 
          
          RowBox[{
           RowBox[{"Conjugate", "[", "lamp", "]"}], "\[Rule]", "lamp"}]}], 
         "}"}]}]}], ";", "\n", " ", 
      RowBox[{"Mij", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"FermionSpinSum", "[", 
          RowBox[{
           RowBox[{
           "amps", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
           " ", "cc"}], "]"}], "//", "Contract"}], "//", "DiracSimplify"}]}], 
      ";", "\n", " ", 
      RowBox[{"Mij", "=", 
       RowBox[{"Mij", "/.", "NRrules"}]}], ";", "\n", " ", 
      RowBox[{"Mij", "=", 
       RowBox[{"Mij", "/.", 
        RowBox[{
         RowBox[{"Eps", "[", "__", "]"}], "\[Rule]", "0"}]}]}], ";", "\n", 
      " ", 
      RowBox[{"Mij", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"PowerExpand", "[", "Mij", "]"}], "/.", 
         RowBox[{"mY", "\[Rule]", 
          RowBox[{"mX", "/", "r"}]}]}], "//", "FullSimplify"}]}]}]}], "\n", 
    "]"}]}], ";"}]], "Input",
