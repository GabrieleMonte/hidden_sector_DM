             RowBox[{"[", "i", "]"}], "]"}], " ", 
            RowBox[{"signs", "[", 
             RowBox[{"[", "j", "]"}], "]"}], " ", 
            RowBox[{"proc", "[", 
             RowBox[{"i", ",", "j"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Put", "[", 
           RowBox[{"term", ",", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"outputDir", ",", 
               RowBox[{"\"\<offdiag_\>\"", "<>", 
                RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<_\>\"", "<>", 
                
                RowBox[{"ToString", "[", "j", "]"}], "<>", "\"\<.m\>\""}]}], 
              "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Clear", "[", "term", "]"}], ";"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"i", "+", "1"}], ",", "16"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<  Done with i = \>\"", ",", "i", ",", "\"\<.\>\""}], 
        "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "16"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nAll 136 terms saved to: \>\"", ",", "outputDir"}], "]"}],
     ";"}]}]}]], "Input",
