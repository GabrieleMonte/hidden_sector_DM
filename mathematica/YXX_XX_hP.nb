        RowBox[{"Mij", "=", 
         RowBox[{"Mij", "/", 
          RowBox[{"(", 
           RowBox[{"dI", " ", "dJ"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Mij", "=", 
